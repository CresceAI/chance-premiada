# =============================================================================
# CHANCE PREMIADA — VARIÁVEIS DE AMBIENTE (MODELO PARA A VERCEL)
# =============================================================================

# 1. OPÇÃO 1 DE PAGAMENTO: ASAAS (PIX AUTOMÁTICO VIA API v3)
ASAAS_API_KEY="$aact_SEU_TOKEN_DO_ASAAS_AQUI"
ASAAS_ENVIRONMENT="production"

# 2. OPÇÃO 2 DE PAGAMENTO (TAXA ZERO): CHAVE PIX DIRETA + CONFERÊNCIA NO ADMIN
VITE_DIRECT_PIX_KEY="sua-chave-pix-aqui"
VITE_DIRECT_PIX_RECEIVER="CHANCE PREMIADA"

# 3. BANCO DE DADOS GRATUITO (SUPABASE - POSTGRESQL)
VITE_SUPABASE_URL="https://SEU_PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua_chave_publishable_ou_anon_do_supabase"

# 4. E-MAIL GRATUITO + PLANILHA GOOGLE AUTOMÁTICA (GOOGLE APPS SCRIPT)
VITE_GOOGLE_APPS_SCRIPT_WEBHOOK_URL="https://script.google.com/macros/s/SEU_SCRIPT_ID/exec"

# 5. PIN DE SEGURANÇA DO PAINEL ADMIN
VITE_ADMIN_PIN="alterar-para-seu-pin"

# 6. ALERTAS EM TEMPO REAL NO TELEGRAM (SERVERLESS - SEGURO NA VERCEL)
TELEGRAM_BOT_TOKEN="seu_token_do_botfather"
TELEGRAM_ADMIN_CHAT_ID="seu_chat_id_privado"
TELEGRAM_PUBLIC_CHANNEL_ID="@seu_canal_publico"
